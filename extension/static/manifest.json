{
  "manifest_version": 3,
  "name": "Moley",
  "version": "0.1.0",
  "description": "Route sites through your VPNs and proxies with Moley.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["proxy", "privacy", "nativeMessaging", "storage", "tabs", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
